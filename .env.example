# Copia este archivo como .env y rellena los valores reales.
# No subas nunca .env al repositorio.

# --- API ---
# Puerto local del backend Express. En Vercel NO definas PORT: lo gestiona la plataforma.
PORT=3001

# Cadena de conexión de PostgreSQL (Neon recomendado).
# Para Vercel usa preferiblemente la cadena "pooled" de Neon.
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require

# Secreto para firmar los JWT. Debe tener al menos 24 caracteres y no ser "secret123".
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon-aqui-un-secreto-aleatorio-de-48-bytes

# Orígenes permitidos por CORS, separados por comas (sin barra final).
# En Vercel frontend y API comparten origen, así que puede quedarse vacío.
# La API acepta además localhost y cualquier *.vercel.app.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Máximo de conexiones PostgreSQL por instancia serverless (por defecto 3).
# PG_POOL_MAX=3

# --- Frontend (Vite) ---
# Déjalo vacío en local (Vite hace proxy de /api) y también en Vercel
# (frontend y API comparten el mismo dominio).
VITE_API_URL=
